# Every checkout is byte-identical to the repository: no line-ending conversion, ever.
# Windows checkouts default to core.autocrlf=true, which rewrote signed PDFs (breaking their
# signatures) and assets whose SHA-256 ATTRIBUTION.toml records (cargo xtask assets).
* -text

# The craft-i18n pin: CI and the build read it as one SHA, so it stays LF everywhere (readers trim it too).
craft-i18n.rev text eol=lf

# Not text at all: no textual diffs or merges either.
*.pdf binary
*.p12 binary
*.pfb binary
*.ttf binary
*.icc binary
*.icns binary
*.ico binary
*.png binary
*.brotli binary

# PDFflow (rebrand/apply.py): files we replace whole keep our version in a merge.
# Needs `git config merge.ours.driver true` once per clone (docs/UPSTREAM.md).
README.md merge=ours
.github/workflows/release.yml merge=ours
.github/workflows/windows-release.yml merge=ours
assets/app-icon/** merge=ours
